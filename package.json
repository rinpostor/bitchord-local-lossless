{
  "name": "bitchord-local-lossless",
  "version": "1.0.0",
  "description": "Local lossless music server exposed as a BitChord addon - tuned for aptX Lossless + UGREEN 40759 + Popcorn Bass X8 Pro",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scan": "node scripts/rescan.js",
    "docker:build": "docker build -t bitchord-local-lossless .",
    "docker:run": "docker compose up -d",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop bitchord-local-lossless",
    "pm2:logs": "pm2 logs bitchord-local-lossless"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mime-types": "^2.1.35",
    "music-metadata": "^10.9.1",
    "range-parser": "^1.2.1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "bitchord",
    "addon",
    "lossless",
    "flac",
    "aptx",
    "ugreen",
    "popcorn"
  ],
  "license": "GPL-3.0"
}
