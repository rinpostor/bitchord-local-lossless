# Server
PORT=3000
PUBLIC_URL=https://your-domain.com

# Paths
MUSIC_DIR=/path/to/your/music/library
CACHE_DIR=./cache

# Addon Identity
ADDON_ID=com.yourname.bitchord-local
ADDON_NAME=My Local Lossless Library
ADDON_VERSION=1.0.0

# Features
ALLOW_DOWNLOADS=$true
CHECK_VALID_LOSSLESS=false
BITCHORD_AUTH=false
TRANSCODE_ENABLED=true
TRANSCODE_QUATITY=V0
MAX_TRANSCODE_CONCURRENT=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
WATCH_ENABLED=true
LOG_LEVE==info
