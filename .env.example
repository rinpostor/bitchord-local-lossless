# Server
PORT=3000

# Public HTTPS origin the phone reaches.
# Leave empty to auto-detect per request (works with ngrok/cloudflared without editing).
PUBLIC_URL=

# Paths
MUSIC_DIR=./music
CACHE_DIR=./cache

# Addon identity (shown in BitChord)
ADDON_ID=com.rinpostor.bitchord.local-lossless
ADDON_NAME=Local Lossless Library
ADDON_VERSION=1.0.0
ADDON_DESCRIPTION=Your own FLAC library streamed straight to BitChord.

# Features
ALLOW_DOWNLOADS=true
CHECK_VALID_LOSSLESS=false
TRANSCODE_ENABLED=true
TRANSCODE_BITRATE_HIGH=320k
TRANSCODE_BITRATE_LOW=128k
MAX_TRANSCODE_CONCURRENT=2
FFMPEG_PATH=ffmpeg

# Library watcher (picks up files added/removed without a restart)
WATCH_ENABLED=true
WATCH_DEBOUNCE_MS=4000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# Optional: require ?token=... or "Authorization: Bearer ..." on /search and /rescan
ACCESS_TOKEN=

# Lifetime of signed media URLs (seconds). Keep between 900 and 1800.
MEDIA_URL_TTL_SECONDS=1500

# Fixed signing key. Leave empty to auto-generate into cache/.secret
MEDIA_SECRET=

LOG_LEVEL=info
